# Runtime
NODE_ENV=development
PORT=3000

# Database (PostgreSQL 15+)
DB_HOST=localhost
DB_PORT=5432
DB_USER=shop
DB_PASSWORD=shop
DB_NAME=shop

# Auth
# Use a long random string in production, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Registration gate. Leave empty to keep signups open; set a value to require it.
INVITE_CODE=

# File uploads
UPLOADS_DIR=./uploads

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://teldaftar.uz

# Throttling for /auth/* (per IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=5
